# Contact form email sending (see src/app/api/kontakt/route.ts)
# Get this from https://resend.com/api-keys after verifying the sending domain.
# Never commit the real value - set it as an environment variable in Vercel
# (or your local .env.local, which is gitignored).
RESEND_API_KEY=

# Optional overrides - sensible defaults are used if unset.
# Sender address, must be on a domain verified in Resend.
RESEND_FROM_EMAIL="Visibility One <kontakt@visibility-one.de>"
# Recipient of the contact form emails.
RESEND_TO_EMAIL=info@visibility-one.de
